{
  "$schema": "modelable.facets/v1",
  "schemas": [
    {
      "identity": "org.example/confidentiality@1",
      "value_schema": {
        "type": "string",
        "enum": ["internal", "restricted"]
      },
      "allowed_subjects": ["declaration"],
      "propagation": "inherit"
    },
    {
      "identity": "org.example/jurisdiction@1",
      "value_schema": {
        "type": "object",
        "properties": {
          "lawful_basis": {
            "type": "string",
            "enum": ["contract", "consent"]
          },
          "region": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "required": ["lawful_basis", "region"],
        "additionalProperties": false
      },
      "allowed_subjects": ["declaration"],
      "propagation": "inherit"
    },
    {
      "identity": "org.example/data-subject@1",
      "value_schema": {
        "type": "string",
        "enum": ["customer", "employee"]
      },
      "allowed_subjects": ["field", "projection_field"],
      "propagation": "project"
    },
    {
      "identity": "org.example/retention-class@1",
      "value_schema": {
        "type": "string",
        "enum": ["regulated", "transient"]
      },
      "allowed_subjects": ["field", "projection_field"],
      "propagation": "project"
    }
  ],
  "facets": [
    {
      "identity": "org.example/confidentiality@1",
      "value": "restricted",
      "subject": "declaration:customer.CustomerRecord@1",
      "propagation": "inherit"
    },
    {
      "identity": "org.example/jurisdiction@1",
      "value": {
        "lawful_basis": "consent",
        "region": "SE"
      },
      "subject": "declaration:customer.CustomerRecord@1",
      "propagation": "inherit"
    },
    {
      "identity": "org.example/data-subject@1",
      "value": "customer",
      "subject": "field:customer.CustomerRecord@1#email",
      "propagation": "project"
    },
    {
      "identity": "org.example/retention-class@1",
      "value": "regulated",
      "subject": "field:customer.CustomerRecord@1#customerId",
      "propagation": "project"
    }
  ]
}
