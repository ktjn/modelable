domain customer {
  owner: "customer-platform-team"
  contact: "customer-platform@example.com"
  description: "Customer identity, lifecycle, loyalty tier, and acquisition attribution."

  // Shared across this domain's own fields and referenced from other domains
  // (e.g. payments.PaymentTransaction.cardIssuerCountry) as `customer.CountryCode`.
  semantic CountryCode: string

  entity Customer @ 3 (additive) {
    @key       customerId:         uuid
    @pii       email:              string
    @pii       phoneNumber?:       string
    @pii       fullName:           string
               countryCode:        CountryCode
               acquisitionChannel?: enum(organic, email, paid_search, social, referral, direct, affiliate)
               acquisitionDate?:   date
               firstCampaignId?:   string
               loyaltyTier?:       enum(bronze, silver, gold, platinum)
               status:             enum(active, suspended, deleted)
               createdAt:          timestamp
               updatedAt:          timestamp
  }

  index Customer @ 3 {
    primary customerId

    // Login and support lookups resolve by email; one active account per address.
    secondary byEmail {
      key:    [email]
      unique: true
    }

    // Lifecycle dashboards filter by status and sort within tier.
    secondary byStatus {
      key:  [status]
      sort: [loyaltyTier]
    }
  }
}
