// Product catalog domain.
// Demonstrates auto projections with default rules and inline customisation.

domain catalog {
  owner: "catalog-team"
  contact: "catalog-team@example.com"
  description: "Product and category definitions for the storefront."

  // ── Entity definition ─────────────────────────────────────────────────────
  //
  // @server marks fields assigned by the server at write time.
  // These fields are excluded from the generated request model automatically.

  entity Product @ 1 (additive) {
    @key         productId:    uuid
                 sku:          string
                 name:         string
                 description?: string
                 priceCents:   int
                 currency:     string
                 status:       enum(draft, active, discontinued)
    @server      createdAt:    timestamp
    @server      updatedAt?:   timestamp
  }

  // Version 2 adds a backwards-compatible merchandising field, authored as
  // an evolves delta against @ 1 instead of repeating the complete field
  // list. The separate auto-projection block keeps ProductReply@1
  // available for existing clients while publishing ProductReply@2 for
  // consumers that need the new field.
  entity Product @ 2 (additive) evolves @ 1 {
    add brand?: string
  }

  // ── Auto projections ──────────────────────────────────────────────────────
  //
  // Neither Product version declares its own `auto projections` block --
  // this workspace's modelable.toml sets [defaults] auto_projections =
  // ["db", "request", "reply", "event"], which the compiler lowers into
  // exactly that block for every model version that doesn't already
  // declare one explicitly (see `modelable config explain`). Four models
  // are generated for each version:
  //
  //   ProductDb @ N        — all fields; used for Postgres DDL and storage bindings
  //   ProductRequest @ N   — client write model; @server fields excluded
  //   ProductReply @ N     — API read model; all fields
  //   ProductEvent @ N     — change event; all fields; emitted on create/update/delete
  //
  // Category, below, needs its own explicit block instead: the config
  // default can only express "all four, unfiltered" -- exclude/on
  // customisation always requires an explicit declaration.

  // ── A second entity with customised auto projections ──────────────────────
  //
  // Category has a user-provided key (slug) and no updatedAt.
  // The reply model excludes internal metadata; the event fires only on create and delete.

  entity Category @ 1 (additive) {
    @key         categoryId:   uuid
                 slug:         string
                 label:        string
                 parentId?:    uuid
    @classification("internal")
                 sortOrder:    int
    @server      createdAt:    timestamp
  }

  auto projections Category @ 1 {
    db

    request
      exclude [sortOrder]           // clients do not set sort order

    reply
      exclude [@classification("internal")]   // hide internal fields from API consumers

    event
      on [created, deleted]         // category updates do not need to trigger downstream sync
  }
}
