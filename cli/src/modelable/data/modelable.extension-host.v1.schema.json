{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modelable.extension-host/v1",
  "title": "Modelable extension host v1",
  "oneOf": [
    {
      "title": "Extension request",
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "kind", "extension", "plan", "configuration"],
      "properties": {
        "$schema": {"const": "modelable.extension-host/v1"},
        "kind": {"const": "extension_request"},
        "extension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "implementation_hash"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "implementation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "plan": {"type": "object"},
        "configuration": {"type": "object"},
        "virtual_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "content": {"type": "string"}
            }
          }
        }
      }
    },
    {
      "title": "Extension result",
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "kind", "status", "artifacts", "diagnostics", "compatibility_findings"],
      "properties": {
        "$schema": {"const": "modelable.extension-host/v1"},
        "kind": {"const": "extension_result"},
        "status": {"enum": ["ok", "failed"]},
        "artifacts": {"type": "array"},
        "diagnostics": {"type": "array"},
        "compatibility_findings": {"type": "array"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  ]
}
