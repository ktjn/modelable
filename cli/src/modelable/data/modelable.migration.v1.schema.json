{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modelable.migration/v1",
  "title": "Modelable migration/v1 metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "mappings"],
  "properties": {
    "$schema": {"const": "modelable.migration/v1"},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sources", "targets"],
        "properties": {
          "kind": {"enum": ["rename", "move", "field_move", "split", "merge", "replacement"]},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
