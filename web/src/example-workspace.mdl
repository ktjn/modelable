workspace {
  name: "playground-example"
  description: "Four independent master source systems -- customer (CRM), sales (product catalogue), oms (order management), and payments (PSP) -- consolidated by a billing domain that joins across all three transactional systems to establish lineage, then aggregates on top of that lineage into a per-customer billing summary."

  generate {
    docs          -> "./generated/docs/"
    typescript    -> "./generated/types/"
    jsonschema    -> "./generated/jsonschema/"
    sql(postgres) -> "./generated/sql/"
    openapi       -> "./generated/api/"
    asyncapi      -> "./generated/events/"
  }
}
