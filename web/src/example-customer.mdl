domain customer {
  owner: "customer-platform"

  entity Customer @ 1 (additive) {
    @key customerId: uuid
    legalName: string
    @pii
    email?: string
    status: enum(active, suspended, closed)
    createdAt: timestamp
  }

  entity Customer @ 2 (additive) {
    @key customerId: uuid
    legalName: string
    @pii
    email?: string
    @classification("confidential")
    creditLimit?: decimal(12, 2)
    status: enum(active, suspended, closed)
    createdAt: timestamp
  }

  // Compiler-expanded models: CustomerDb, CustomerRequest, CustomerReply,
  // and CustomerEvent (fired on created / updated / deleted).
  auto projections Customer @ 2 {
    db
    request
    reply
    event
  }
}
