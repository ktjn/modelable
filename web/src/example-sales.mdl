domain sales {
  owner: "sales-platform"
  description: "Product catalogue -- the master system of record for sellable items. Order placement lives in the oms domain, which references products here by id."

  entity Product @ 1 (additive) {
    @key productId: uuid
    name: string
    sku: string
    category: enum(physical, digital, subscription)
    tags: array<string>
    unitPrice: decimal(10, 2)
    createdAt: timestamp
  }
}
